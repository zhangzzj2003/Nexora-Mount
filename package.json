{
  "name": "nexora-mount",
  "version": "0.1.0",
  "private": true,
  "description": "直接使用 NAS 工作目录的跨平台挂载管理工具",
  "author": "Nexora",
  "license": "MPL-2.0",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "pack": "pnpm build && electron-builder --dir",
    "dist:mac": "pnpm build && electron-builder --mac dmg --arm64 --x64",
    "dist:win": "pnpm build && electron-builder --win nsis --x64",
    "format": "prettier --write src tests *.ts *.json *.yml .github/workflows/*.yml",
    "format:check": "prettier --check src tests *.ts *.json *.yml .github/workflows/*.yml"
  },
  "dependencies": {
    "@lucide/vue": "1.61.0",
    "koffi": "3.3.3",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "45.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "koffi",
      "app-builder-bin"
    ]
  },
  "optionalDependencies": {
    "@koromix/koffi-darwin-arm64": "3.3.3",
    "@koromix/koffi-darwin-x64": "3.3.3",
    "@koromix/koffi-win32-x64": "3.3.3"
  }
}
